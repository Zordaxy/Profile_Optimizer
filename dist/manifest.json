{
    "manifest_version": 3,
    "name": "Profile Optimizer",
    "version": "0.1.0",
    "description": "AI-powered Profile Optimization tool",
    "permissions": [
        "activeTab"
    ],
    "action": {
        "default_icon": "icon.png",
        "default_popup": "popup/index.html",
        "default_title": "Profile Optimizer"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content-script/index.js"
            ]
        }
    ]
}